# ==============================================================================
# AIOps Sentinel - Frontend Environment Template
# ==============================================================================
# Copy this file to 'aiops-sentinel/.env':
#   Windows (PowerShell): Copy-Item aiops-sentinel/.env.example aiops-sentinel/.env
#   Linux/macOS:          cp aiops-sentinel/.env.example aiops-sentinel/.env
# ==============================================================================

# API Base URL for backend communications (Proxied by Vite dev server by default)
VITE_API_BASE_URL="/api/v1"

# Standalone development target if bypassing Vite proxy
# VITE_BACKEND_URL="http://localhost:8000"
