# ==============================================================================
# AIOps Sentinel - Backend Local Development Environment Template
# ==============================================================================
# Copy this file to 'backend/.env' for local non-Docker development:
#   Windows (PowerShell): Copy-Item backend/.env.example backend/.env
#   Linux/macOS:          cp backend/.env.example backend/.env
# ==============================================================================

# Database connection (Points to localhost:5432 for host development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aiops_sentinel?schema=public"

# Authentication Security
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"

# Agent Security Token
AGENT_API_TOKEN="replace-with-a-unique-agent-token-min-32-chars"
GITHUB_WEBHOOK_SECRET="replace-with-a-unique-webhook-secret"

# Monitoring & Redis
REDIS_URL="redis://localhost:6379/0"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
MLFLOW_TRACKING_URI="sqlite:///mlflow.db"
