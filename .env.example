# ==============================================================================
# AIOps Sentinel - Root Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      Windows (PowerShell): Copy-Item .env.example .env
#      Linux/macOS:          cp .env.example .env
# 2. Replace all placeholder values below before starting containers.
# 3. Never commit '.env' containing real secrets to version control.
# ==============================================================================

# --- Database Configuration (PostgreSQL 15) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-database-password-min-16-chars
POSTGRES_DB=aiops_sentinel
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public

# --- Authentication & Cryptographic Security ---
# JWT Secret must be a high-entropy string of at least 32 characters.
# Generate one in PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Initial Bootstrap Administrator Account (Created automatically on startup)
ADMIN_EMAIL=admin@localhost
# Password must be between 12 and 72 UTF-8 characters.
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# --- Telemetry & Host Agent Security ---
# Cryptographic token required by the Windows Host Agent in the 'X-Agent-Token' header.
AGENT_API_TOKEN=replace-with-a-unique-agent-token-min-32-chars

# --- Integrations & Webhooks ---
# Secret for validating HMAC signatures on incoming GitHub webhook deployments.
GITHUB_WEBHOOK_SECRET=replace-with-a-unique-webhook-secret
# Outgoing Webhook URL (Slack / Discord / PagerDuty) for alerting notifications.
NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# --- Observability Stack Credentials ---
GRAFANA_PASSWORD=replace-with-a-unique-grafana-password
REDIS_URL=redis://redis:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
MLFLOW_TRACKING_URI=http://backend:8000/mlruns
